{
  "name": "qwen2.5-7b-instruct",
  "description": "Primary StopLoss backbone (paper App. A). The five seeds form the primary ensemble.",
  "model": "Qwen/Qwen2.5-7B-Instruct",
  "gpus": 1,
  "batch_size": 2,
  "grad_accum": 8,
  "seeds": [0, 1, 2, 3, 4],
  "max_len": 1600,
  "epochs": 1.0,
  "lr": 0.0001,
  "weight_decay": 0.05,
  "warmup_ratio": 0.03,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "gradient_checkpointing": true,
  "eval_every": 300,
  "val_trajectories": 150
}
